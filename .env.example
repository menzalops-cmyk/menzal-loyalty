# ===== الأساسيات =====
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://menzal:menzal_dev@localhost:5432/menzal
# مفتاح سري طويل وعشوائي (يُستخدم لتجزئة رموز الجلسات وروابط التتبع)
APP_SECRET=change-me-to-a-long-random-string
# تشغيل العامل الخلفي داخل نفس العملية (إشعارات، حملات مجدولة، انتهاء صلاحية)
RUN_WORKER=true
WORKER_INTERVAL_SECONDS=60

# ===== البريد الإلكتروني (SMTP) — اتركه فارغًا ليعمل في وضع السجل فقط =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="منزال <no-reply@example.com>"

# ===== واتساب (WhatsApp Business Cloud API الرسمي من Meta) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# لغة القوالب المعتمدة
WHATSAPP_TEMPLATE_LANG=ar

# ===== تكامل منصة الحجز الخارجية (Webhook) =====
# سر مشترك للتحقق من توقيع HMAC-SHA256 في الترويسة X-Menzal-Signature
BOOKING_WEBHOOK_SECRET=

# ===== مدير النظام الأول (يُنشأ عند تشغيل npm run seed) =====
ADMIN_EMAIL=admin@menzal.local
ADMIN_PASSWORD=
