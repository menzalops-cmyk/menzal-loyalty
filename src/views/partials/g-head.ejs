<%- include('doc-head') %>
<body>
<% if (locals.demoMode) { %><div style="background:#9a6b12;color:#fff;text-align:center;font-size:.8rem;padding:.3rem 1rem">نسخة تجريبية — الرسائل لا تُرسل فعليًا ورموز التحقق تظهر على الشاشة</div><% } %>
<header class="g-header">
  <div class="inner">
    <%- include('logo', { href: locals.guest ? '/account' : '/', sub: 'ضيوف مِنزال 🤍' }) %>
    <% if (locals.guest) { %>
      <nav class="g-nav" aria-label="القائمة الرئيسية">
        <a href="/account" class="<%= path === '/' ? 'active' : '' %>">حسابي</a>
        <a href="/account/rewards" class="<%= path.startsWith('/rewards') ? 'active' : '' %>">المكافآت</a>
        <a href="/account/rebook" class="<%= path.startsWith('/rebook') || path.startsWith('/book') ? 'active' : '' %>">احجز</a>
        <a href="/account/bookings" class="<%= path.startsWith('/bookings') ? 'active' : '' %>">حجوزاتي</a>
        <a href="/account/referrals" class="<%= path.startsWith('/referrals') ? 'active' : '' %>">ادعُ صديقًا</a>
      </nav>
      <div class="row" style="gap:.25rem">
        <a href="/account/notifications" class="bell" aria-label="الإشعارات"><%- include('icon', { name: 'bell' }) %><% if (locals.unread) { %><span class="dot"><%= unread > 9 ? '9+' : unread %></span><% } %></a>
        <a href="/account/preferences" class="bell" aria-label="الإعدادات"><%- include('icon', { name: 'user' }) %></a>
      </div>
    <% } else { %>
      <div class="row"><a href="/login" class="btn btn-ghost btn-sm">دخول</a><a href="/signup" class="btn btn-primary btn-sm">انضم مجانًا</a></div>
    <% } %>
  </div>
</header>
<% if (locals.guest && !locals.noTabbar) { %>
<nav class="g-tabbar" aria-label="التنقل">
  <a href="/account" class="<%= path === '/' ? 'active' : '' %>"><%- include('icon', { name: 'home' }) %>حسابي</a>
  <a href="/account/rewards" class="<%= path.startsWith('/rewards') ? 'active' : '' %>"><%- include('icon', { name: 'gift' }) %>المكافآت</a>
  <a href="/account/rebook" class="cta <%= path.startsWith('/rebook') ? 'active' : '' %>"><span class="ti"><%- include('icon', { name: 'key' }) %></span>احجز</a>
  <a href="/account/bookings" class="<%= path.startsWith('/bookings') ? 'active' : '' %>"><%- include('icon', { name: 'calendar' }) %>حجوزاتي</a>
  <a href="/account/referrals" class="<%= path.startsWith('/referrals') ? 'active' : '' %>"><%- include('icon', { name: 'users' }) %>ادعُ</a>
</nav>
<% } %>
<main class="g-main">
<%- include('flash') %>
