<%- include('../partials/a-head') %>
<div class="a-top">
  <div><h1>لوحة المؤشرات</h1><p class="muted small mb-0"><%= program ? `البرنامج النشط: ${program.name}` : 'لا يوجد برنامج ولاء نشط — لن تُمنح نقاط' %></p></div>
  <div class="tabs mb-0"><a href="/admin" class="<%= !days ? 'active' : '' %>">الكل</a><a href="/admin?days=30" class="<%= days === 30 ? 'active' : '' %>">30 يومًا</a><a href="/admin?days=90" class="<%= days === 90 ? 'active' : '' %>">90 يومًا</a><a href="/admin?days=365" class="<%= days === 365 ? 'active' : '' %>">سنة</a></div>
</div>
<% if (!program) { %><div class="alert alert-error">برنامج الولاء متوقف. <a href="/admin/loyalty">فعّله من هنا</a></div><% } %>
<div class="grid grid-4">
  <div class="kpi accent"><div class="k-label">أعضاء برنامج الولاء</div><div class="k-value num"><%= fmt.num(k.members.total) %></div><div class="k-sub">+<span class="num"><%= fmt.num(k.members.new) %></span> في الفترة</div></div>
  <div class="kpi"><div class="k-label">ضيوف عادوا للحجز</div><div class="k-value num"><%= fmt.num(k.returningGuests) %></div><div class="k-sub">ضيف لديه حجز متكرر</div></div>
  <div class="kpi"><div class="k-label">نسبة الحجوزات المتكررة</div><div class="k-value num"><%= k.repeatRate %>%</div><div class="k-sub"><span class="num"><%= fmt.num(k.bookings.repeat) %></span> من <span class="num"><%= fmt.num(k.bookings.total) %></span> حجز</div></div>
  <div class="kpi"><div class="k-label">إيرادات الحجوزات المتكررة</div><div class="k-value num"><%= fmt.money(k.bookings.repeat_revenue) %></div><div class="k-sub">من إجمالي <span class="num"><%= fmt.money(k.bookings.revenue) %></span></div></div>
  <div class="kpi"><div class="k-label">النقاط المكتسبة</div><div class="k-value num"><%= fmt.num(k.points.earned) %></div><div class="k-sub">منتهية: <span class="num"><%= fmt.num(k.points.expired) %></span></div></div>
  <div class="kpi"><div class="k-label">النقاط المستبدلة</div><div class="k-value num"><%= fmt.num(k.points.redeemed) %></div><div class="k-sub">رصيد قائم: <span class="num"><%= fmt.num(k.liability.outstanding) %></span><% if (program) { %> ≈ <span class="num"><%= fmt.money(k.liability.outstanding * program.point_value) %></span><% } %></div></div>
  <div class="kpi"><div class="k-label">قيمة المكافآت المستخدمة</div><div class="k-value num"><%= fmt.money(k.rewards.value) %></div><div class="k-sub"><span class="num"><%= fmt.num(k.rewards.used) %></span> مكافأة مستخدمة</div></div>
  <div class="kpi"><div class="k-label">الإحالات الناجحة</div><div class="k-value num"><%= fmt.num(k.referrals.success) %></div><div class="k-sub">معلقة: <span class="num"><%= fmt.num(k.referrals.pending) %></span></div></div>
  <div class="kpi"><div class="k-label">التفاعل مع الحملات</div><div class="k-value num"><%= k.engagementRate %>%</div><div class="k-sub"><span class="num"><%= fmt.num(k.engagement.engaged) %></span> متفاعل من <span class="num"><%= fmt.num(k.engagement.reached) %></span></div></div>
</div>
<div class="grid grid-2 mt-3" style="align-items:start">
  <div class="card">
    <div class="row between"><h3 class="mb-0">الحجوزات الشهرية</h3><div class="legend"><span><i style="background:var(--gold-500)"></i>متكررة</span><span><i style="background:var(--brand-100)"></i>جديدة</span></div></div>
    <% const max = Math.max(1, ...k.monthly.map((m) => m.total)); %>
    <% if (!k.monthly.length) { %><p class="muted mt-2">لا توجد حجوزات بعد.</p><% } else { %>
    <div class="bars" role="img" aria-label="الحجوزات الشهرية">
      <% k.monthly.forEach((m) => { %><div class="bar" title="<%= m.month %>: <%= m.total %> (متكررة <%= m.repeat %>)"><div class="stack-col" style="height:<%= Math.round(100 * m.total / max) %>%"><div class="seg-rep" style="flex:<%= m.repeat %>"></div><div class="seg-new" style="flex:<%= m.total - m.repeat %>"></div></div><small class="num"><%= m.month.slice(5) %></small></div><% }) %>
    </div><% } %>
  </div>
  <div class="card">
    <div class="row between"><h3 class="mb-0">آخر عمليات النقاط</h3><a href="/admin/guests" class="small">الضيوف</a></div>
    <% if (!recent.length) { %><p class="muted mt-2">لا توجد عمليات بعد.</p><% } %>
    <% recent.forEach((l) => { %><div class="summary-line small"><span><a href="/admin/guests/<%= l.guest_id %>"><%= l.full_name %></a> · <%= L.ledger[l.entry_type] %></span><span class="num <%= l.points > 0 ? 'pos' : 'neg' %>"><%= l.points > 0 ? '+' : '' %><%= fmt.num(l.points) %></span></div><% }) %>
  </div>
</div>
<% if (topCampaigns.length) { %>
<div class="card mt-3" style="padding:0"><div class="table-wrap"><table>
  <thead><tr><th>آخر الحملات</th><th>المستلمون</th><th>التفاعل</th><th>حجوزات</th><th>إيرادات</th></tr></thead>
  <tbody><% topCampaigns.forEach((c) => { %><tr><td><a href="/admin/campaigns/<%= c.id %>"><%= c.name %></a></td><td class="num"><%= c.stats.reached %></td><td class="num"><%= c.stats.engagementRate %>%</td><td class="num"><%= c.stats.bookings %></td><td class="num"><%= fmt.money(c.stats.revenue) %></td></tr><% }) %></tbody>
</table></div></div>
<% } %>
<%- include('../partials/a-foot') %>
