<%- include('../partials/doc-head') %>
<body style="background:var(--brand-900);min-height:100vh;display:grid;place-items:center;padding:1rem">
<div style="width:100%;max-width:400px">
  <div class="center mb-2" style="display:flex;justify-content:center"><%- include('../partials/logo', { href: '/admin/login', sub: 'لوحة إدارة الولاء' }) %></div>
  <div class="card">
  <%- include('../partials/flash') %>
  <form method="post" action="/admin/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="email">البريد الإلكتروني</label><input id="email" type="email" name="email" dir="ltr" required autocomplete="username"></div>
    <div class="field"><label for="password">كلمة المرور</label><input id="password" type="password" name="password" required autocomplete="current-password"></div>
    <button class="btn btn-primary btn-block">دخول</button>
  </form>
  </div>
</div>
</body></html>
