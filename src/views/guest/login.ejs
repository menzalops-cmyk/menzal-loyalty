<%- include('../partials/g-head') %>
<div class="auth-wrap">
  <div class="card">
    <% if (!sent) { %>
      <h1>تسجيل الدخول</h1>
      <p class="muted">أدخل رقم جوالك وسنرسل لك رمز دخول.</p>
      <%- include('../partials/flash') %>
      <form method="post" action="/login/code/send">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
        <div class="field"><label for="phone">رقم الجوال</label><input id="phone" type="tel" name="phone" dir="ltr" inputmode="tel" placeholder="05XXXXXXXX" required value="<%= phone %>" autocomplete="tel"></div>
        <button class="btn btn-primary btn-block">أرسل رمز الدخول</button>
      </form>
      <p class="center small mt-2 mb-0">جديد في منزال؟ <a href="/signup">أنشئ حسابًا</a></p>
    <% } else { %>
      <h1><%= locals.signup ? 'تأكيد رقم الجوال' : 'أدخل رمز الدخول' %></h1>
      <p class="muted">أرسلنا رمزًا من 6 أرقام إلى <b dir="ltr">+<%= phone %></b> عبر واتساب. صالح لمدة 15 دقيقة.</p>
      <% if (locals.signup) { %><p class="small muted">بعد التأكيد سنربط أي حجوزات سابقة مسجلة بهذا الرقم ونحسب نقاطها.</p><% } %>
      <%- include('../partials/flash') %>
      <% if (locals.devCode) { %><div class="alert alert-warn small">نسخة تجريبية (مزود الرسائل غير مربوط): الرمز <b class="num"><%= devCode %></b></div><% } %>
      <form method="post" action="/login/code">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
        <input type="hidden" name="phone" value="<%= phone %>"><input type="hidden" name="signup" value="<%= locals.signup ? '1' : '' %>">
        <div class="field"><input type="text" name="code" class="otp" inputmode="numeric" maxlength="6" required autocomplete="one-time-code" aria-label="رمز التحقق" autofocus></div>
        <button class="btn btn-primary btn-block">تأكيد</button>
      </form>
      <form method="post" action="/login/code/send" class="center mt-2">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><input type="hidden" name="phone" value="<%= phone %>">
        <button class="linklike small">لم يصلك الرمز؟ أعد الإرسال</button>
      </form>
      <p class="center small mt-1 mb-0"><a href="/login">تغيير الرقم</a></p>
    <% } %>
  </div>
</div>
<%- include('../partials/g-foot') %>
