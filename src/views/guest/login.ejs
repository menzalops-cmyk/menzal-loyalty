<%- include('../partials/g-head') %>
<div class="auth-wrap">
  <div class="card">
    <h1>تسجيل الدخول</h1>
    <div class="tabs"><a href="/login?next=<%= encodeURIComponent(next || '') %>" class="<%= mode === 'password' ? 'active' : '' %>">بكلمة المرور</a><a href="/login?mode=code&next=<%= encodeURIComponent(next || '') %>" class="<%= mode === 'code' ? 'active' : '' %>">برمز عبر البريد</a></div>
    <%- include('../partials/flash') %>
    <% if (mode === 'password') { %>
      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
        <div class="field"><label for="email">البريد الإلكتروني</label><input id="email" type="email" name="email" dir="ltr" required value="<%= email %>" autocomplete="email"></div>
        <div class="field"><label for="password">كلمة المرور</label><input id="password" type="password" name="password" required autocomplete="current-password"></div>
        <button class="btn btn-primary btn-block">دخول</button>
      </form>
      <p class="center small mt-2 mb-0">نسيت كلمة المرور أو حجزت بدون حساب؟ <a href="/login?mode=code">ادخل برمز</a></p>
    <% } else if (!locals.sent) { %>
      <p class="muted small">أدخل بريدك وسنرسل لك رمز دخول صالحًا لمدة 15 دقيقة.</p>
      <form method="post" action="/login/code/send">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
        <div class="field"><label for="email">البريد الإلكتروني</label><input id="email" type="email" name="email" dir="ltr" required value="<%= email %>"></div>
        <button class="btn btn-primary btn-block">أرسل الرمز</button>
      </form>
    <% } else { %>
      <p class="muted small">أرسلنا رمزًا إلى <b dir="ltr"><%= email %></b></p>
      <% if (locals.devCode) { %><div class="alert alert-warn small">وضع التطوير (البريد غير مُعد): الرمز <b class="num"><%= devCode %></b></div><% } %>
      <form method="post" action="/login/code">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><input type="hidden" name="email" value="<%= email %>">
        <div class="field"><label for="code">رمز الدخول</label><input id="code" name="code" class="otp" inputmode="numeric" maxlength="6" required autocomplete="one-time-code"></div>
        <button class="btn btn-primary btn-block">دخول</button>
      </form>
    <% } %>
    <p class="center small mt-2 mb-0">جديد في منزال؟ <a href="/signup">أنشئ حسابًا</a></p>
  </div>
</div>
<%- include('../partials/g-foot') %>
