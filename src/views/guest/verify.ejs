<%- include('../partials/g-head') %>
<div class="auth-wrap">
  <div class="card">
    <h1>تأكيد البريد الإلكتروني</h1>
    <p class="muted">أدخل الرمز المرسل إلى <b dir="ltr"><%= guest.email %></b>. التأكيد يتيح وصول الإشعارات والعروض لبريدك، ويربط أي حجوزات سابقة مسجلة به.</p>
    <% if (devCode) { %><div class="alert alert-warn small">نسخة تجريبية (البريد غير مربوط): الرمز <b class="num"><%= devCode %></b></div><% } %>
    <form method="post" action="/verify">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><input name="code" class="otp" inputmode="numeric" maxlength="6" required autocomplete="one-time-code" aria-label="رمز التحقق"></div>
      <button class="btn btn-primary btn-block">تأكيد</button>
    </form>
    <form method="post" action="/verify/resend" class="center mt-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike small">أعد إرسال الرمز</button></form>
    <p class="center small mt-1 mb-0"><a href="/account/preferences">رجوع</a></p>
  </div>
</div>
<%- include('../partials/g-foot') %>
