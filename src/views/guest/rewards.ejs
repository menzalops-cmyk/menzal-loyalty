<%- include('../partials/g-head') %>
<div class="page-head"><h1>المكافآت</h1><p class="muted mb-0">رصيدك <b class="num"><%= fmt.num(guest.points_balance) %></b> نقطة — استبدلها بمكافأة واستخدمها عند الحجز.</p></div>
<% const mine = vouchers.filter((v) => v.status === 'available'); %>
<% if (mine.length) { %>
  <h2>مكافآتك المتاحة</h2>
  <div class="grid grid-2"><% mine.forEach((v) => { %><%- include('../partials/voucher', { v }) %><% }) %></div>
  <a href="/account/rebook" class="btn btn-gold mt-2">استخدم مكافأة في حجز جديد</a>
<% } %>
<div class="section-title"><h2>استبدل نقاطك</h2></div>
<% if (!catalog.length) { %><div class="card empty">لا توجد مكافآت متاحة للاستبدال حاليًا.</div><% } %>
<div class="grid grid-3">
<% catalog.forEach((r) => { %>
  <div class="reward-tile">
    <div class="row between"><span class="r-icon"><%- include('../partials/icon', { name: r.reward_type === 'late_checkout' ? 'clock' : r.reward_type === 'free_upgrade' ? 'up' : 'percent' }) %></span><span class="cost num"><%= fmt.num(r.points_cost) %> نقطة</span></div>
    <b><%= r.name %></b>
    <span class="small muted"><%= r.description %></span>
    <span class="tiny muted"><%= r.min_booking_amount > 0 ? `حد أدنى للحجز ${fmt.money(r.min_booking_amount)} · ` : '' %>صالحة <%= r.voucher_validity_days %> يومًا بعد الاستبدال</span>
    <form method="post" action="/account/rewards/<%= r.id %>/redeem">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="request_id" value="<%= requestId %>-<%= r.id %>">
      <% if (r.eligible) { %>
        <button class="btn btn-primary btn-block btn-sm" data-confirm="استبدال <%= r.points_cost %> نقطة بـ «<%= r.name %>»؟">استبدل الآن</button>
      <% } else { %>
        <button class="btn btn-ghost btn-block btn-sm" disabled><%= r.reason %></button>
        <% if (guest.points_balance < r.points_cost) { %><div class="progress light"><span style="width:<%= Math.min(100, Math.round(100 * Math.max(0, guest.points_balance) / r.points_cost)) %>%"></span></div><% } %>
      <% } %>
    </form>
  </div>
<% }) %>
</div>
<% const past = vouchers.filter((v) => v.status !== 'available'); %>
<% if (past.length) { %>
  <details class="box mt-3"><summary>المكافآت السابقة (<span class="num"><%= past.length %></span>)</summary>
    <div class="grid grid-2"><% past.forEach((v) => { %><%- include('../partials/voucher', { v }) %><% }) %></div>
  </details>
<% } %>
<%- include('../partials/g-foot') %>
